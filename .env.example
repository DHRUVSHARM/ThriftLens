# Copy this file to .env for local/prod-like runs.
# Keep real secrets only in .env or deployment secret storage; never commit them.
# This file is configured for REAL_MODE by default so reviewers can add keys and
# exercise the production path. For no-key local demos, set PROVIDER_MODE=SAMPLE_MODE.

# App mode
# SAMPLE_MODE uses deterministic fixtures. REAL_MODE calls Gemini and SerpAPI.
PROVIDER_MODE=REAL_MODE

# Browser/API wiring
# NEXT_PUBLIC_API_BASE_URL is read by the frontend. CORS_ALLOWED_ORIGINS is read by the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Runtime services managed by docker-compose
DATABASE_URL=postgresql+asyncpg://thriftlens:thriftlens@postgres:5432/thriftlens
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
REDIS_URL=redis://redis:6379/0

# Gemini / Google AI Studio provider
# Paid/live secret for REAL_MODE image gate, image/text extraction, schema repair, and optional ranking explanations.
# Get/create the key in Google AI Studio: https://aistudio.google.com/app/apikey
# Set one Gemini-compatible key. Preferred: GEMINI_API_KEY. GOOGLE_API_KEY is the official SDK alias.
# GOOGLE_CLOUD_API_KEY is also supported for the original Luma starter-template key name.

# NOTE : REQUIRED
GEMINI_API_KEY=

# no need to fill these if gemini_api_key is filled
GOOGLE_API_KEY=
GOOGLE_CLOUD_API_KEY=

# Gemini model routing
# GEMINI_MODEL is the legacy/default fallback if a task model setting is blank.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EXTRACTION_MODEL=gemini-3.1-flash-lite
GEMINI_EXTRACTION_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_EXTRACTION_QUALITY_MODEL=gemini-3.5-flash
GEMINI_TEXT_SAFETY_MODEL=gemini-3.1-flash-lite
GEMINI_REPAIR_MODEL=gemini-3.1-flash-lite
GEMINI_RANKING_MODEL=gemini-3.1-flash-lite
GEMINI_RANKING_ENABLED=true

# SerpAPI hosted MCP provider
# Paid/live secret for REAL_MODE source-backed Google Shopping research.
# Get the key from the SerpAPI dashboard: https://serpapi.com/manage-api-key

# NOTE : REQUIRED
SERPAPI_API_KEY=
SERPAPI_MCP_BASE_URL=https://mcp.serpapi.com
SERPAPI_MAX_CALLS_PER_JOB=3

# Provider timeout/retry policy
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=1
PROVIDER_BACKOFF_BASE_SECONDS=2
PROVIDER_BACKOFF_MAX_SECONDS=15
PROVIDER_JITTER_RATIO=0.25

# Provider circuit breaker policy
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_WINDOW_SECONDS=120
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# Image safety/product suitability gate thresholds
INPUT_GATE_MIN_PRODUCT_CONFIDENCE=0.65
INPUT_GATE_TARGET_MATCH_CONFIDENCE=0.70
INPUT_GATE_QUALITY_MODEL_CONFIDENCE=0.82
INPUT_GATE_MAX_PRODUCTS_WITHOUT_TARGET=1

# Text safety gate
# Deterministic rules catch obvious prompt injection, malformed text, unsafe media,
# and regulated product requests. When enabled in REAL_MODE, Gemini adds a
# structured long-tail classifier against the central product-safety taxonomy.
# Leave GEMINI_TEXT_SAFETY_MODEL blank to reuse GEMINI_EXTRACTION_MODEL.
TEXT_SAFETY_MODEL_ENABLED=true
TEXT_SAFETY_MODEL_SAFE_THRESHOLD=0.74
TEXT_SAFETY_MODEL_UNSAFE_THRESHOLD=0.68

# Bounded ReAct-style product understanding
# Enabled for prod-like REAL_MODE runs so the model can decide among
# gate/disambiguation/extraction tools after image/text safety passes.
# Gemini 3.x currently uses the graph-controlled MCP policy loop instead of
# LangChain bound-tool ReAct transcripts because that provider path requires
# thought-signature metadata. Safety/gate/extraction still use model calls.
# Flow when enabled: image safety runs first, then the product-understanding
# agent may call only image_product_gate, disambiguate_target_product, and
# extract_product_reference with PRODUCT_UNDERSTANDING_MAX_TOOL_CALLS as budget.
# Leave PRODUCT_UNDERSTANDING_MODEL blank to reuse GEMINI_EXTRACTION_MODEL.
PRODUCT_UNDERSTANDING_AGENT_ENABLED=true
PRODUCT_UNDERSTANDING_MODEL=gemini-3.1-flash-lite
PRODUCT_UNDERSTANDING_MAX_TOOL_CALLS=3

# Internal MCP servers
# Local Docker Compose can use explicit URLs. Render can omit these and provide
# *_MCP_HOST + *_MCP_PORT from private-service references instead.
# Explicit URLs always take precedence over host/port derivation.
EXTRACTION_MCP_URL=http://extraction-mcp:8001/mcp

# Product Discovery MCP server
# Discovery turns ProductReference into source-backed product candidates.
# The model answers what kind of product this is, how people shop for it,
# which details matter, and which top 2-3 allowed search engines make sense.
# Actual SerpAPI MCP calls are code-driven after the plan is validated.
# Leave DISCOVERY_MODEL blank to reuse GEMINI_EXTRACTION_MODEL.
DISCOVERY_MCP_URL=http://discovery-mcp:8002/mcp
DISCOVERY_MODEL=gemini-3.1-flash-lite
DISCOVERY_MAX_ENGINES=3
DISCOVERY_ENGINE_ALLOWLIST=google_shopping,google,bing_shopping,ebay,amazon,walmart,home_depot

# Product Ranking MCP server
# Ranking scores source-backed candidates, detects mismatch caveats, groups
# products for exploration, and returns source-grounded match explanations.
# GEMINI_RANKING_ENABLED controls the optional model overlay; deterministic
# ranking remains the fallback when the model/server is unavailable.
RANKING_MCP_URL=http://ranking-mcp:8003/mcp

# Temporary object storage
# Local docker-compose uses MinIO through this explicit endpoint.
# Treat access/secret keys as deployment secrets outside local dev.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=thriftlens-uploads
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_SECURE=false

# Gateway intake controls
# Keep these bounded so a reviewer laptop or small deployment cannot accept unbounded work.
MAX_QUEUED_JOBS=50
MAX_ACTIVE_JOBS=10
MAX_UPLOAD_MB=8
MAX_TEXT_LENGTH=2000

# Temporary image retention cleanup
# Uploaded images stay private in MinIO for this TTL, then Celery Beat schedules cleanup.
# Six hours is 21600 seconds. For a local smoke test, use a short value such as 72.
IMAGE_RETENTION_SECONDS=21600
IMAGE_CLEANUP_BATCH_SIZE=100
IMAGE_CLEANUP_INTERVAL_SECONDS=900

# Tests
# Live provider smoke tests are opt-in so automated checks do not spend quota by default.
LIVE_PROVIDER_SMOKE=false
