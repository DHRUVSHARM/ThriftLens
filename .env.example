# Copy this file to .env for local/prod-like runs.
# Keep real secrets only in .env or deployment secret storage; never commit them.
# SAMPLE_MODE runs without paid provider keys. REAL_MODE requires the paid/live keys below.

# App mode
# SAMPLE_MODE uses deterministic fixtures. REAL_MODE calls Gemini and SerpAPI.
PROVIDER_MODE=SAMPLE_MODE

# Browser/API wiring
# NEXT_PUBLIC_API_BASE_URL is read by the frontend. CORS_ALLOWED_ORIGINS is read by the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Runtime services managed by docker-compose
DATABASE_URL=postgresql+asyncpg://thriftlens:thriftlens@postgres:5432/thriftlens
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
REDIS_URL=redis://redis:6379/0

# Gemini / Google AI Studio provider
# Paid/live secret for REAL_MODE image gate, image/text extraction, schema repair, and optional ranking explanations.
# Get/create the key in Google AI Studio: https://aistudio.google.com/app/apikey
# Set one Gemini-compatible key. Preferred: GEMINI_API_KEY. GOOGLE_API_KEY is the official SDK alias.
# GOOGLE_CLOUD_API_KEY is also supported for the original Luma starter-template key name.
GEMINI_API_KEY=xxxxx
GOOGLE_API_KEY=xxxxx
GOOGLE_CLOUD_API_KEY=xxxxx

# Gemini model routing
# GEMINI_MODEL is the legacy/default fallback if a task model setting is blank.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EXTRACTION_MODEL=gemini-3.1-flash-lite
GEMINI_EXTRACTION_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_EXTRACTION_QUALITY_MODEL=gemini-3.5-flash
GEMINI_REPAIR_MODEL=gemini-3.1-flash-lite
GEMINI_RANKING_MODEL=gemini-3.1-flash-lite
GEMINI_RANKING_ENABLED=false

# SerpAPI hosted MCP provider
# Paid/live secret for REAL_MODE source-backed Google Shopping research.
# Get the key from the SerpAPI dashboard: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=xxxxx
SERPAPI_MCP_BASE_URL=https://mcp.serpapi.com
SERPAPI_MAX_CALLS_PER_JOB=2

# Provider timeout/retry policy
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=1
PROVIDER_BACKOFF_BASE_SECONDS=2
PROVIDER_BACKOFF_MAX_SECONDS=15
PROVIDER_JITTER_RATIO=0.25

# Provider circuit breaker policy
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_WINDOW_SECONDS=120
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# Image safety/product suitability gate thresholds
INPUT_GATE_MIN_PRODUCT_CONFIDENCE=0.65
INPUT_GATE_TARGET_MATCH_CONFIDENCE=0.70
INPUT_GATE_QUALITY_MODEL_CONFIDENCE=0.82
INPUT_GATE_MAX_PRODUCTS_WITHOUT_TARGET=1

# Temporary object storage
# Local docker-compose uses MinIO. Treat access/secret keys as deployment secrets outside local dev.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=thriftlens-uploads
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Gateway intake controls
# Keep these bounded so a reviewer laptop or small deployment cannot accept unbounded work.
MAX_QUEUED_JOBS=50
MAX_ACTIVE_JOBS=10
MAX_UPLOAD_MB=8
MAX_TEXT_LENGTH=2000

# Tests
# Live provider smoke tests are opt-in so automated checks do not spend quota by default.
LIVE_PROVIDER_SMOKE=false
